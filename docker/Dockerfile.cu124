FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# 基础工具 + 双编译器
# 注意系统自带 gcc-11 和 g++-11
# 我们又安装了 gcc-13 和 g++-13
RUN apt-get update && apt-get install -y \
    software-properties-common \
    curl \
    wget \
    git \
    ca-certificates \
    pkg-config \
    ninja-build \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    unzip \
    && add-apt-repository ppa:ubuntu-toolchain-r/test -y \
    && apt-get update && apt-get install -y \
    numactl \
    gcc-13 \
    g++-13 \
    && rm -rf /var/lib/apt/lists/*

# uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /workspace/NEO

# 安装 Python 3.12，但不在镜像里创建项目 .venv
RUN uv python install 3.12.12

# 安装 ISPC 1.23 官方 Linux 预编译包
# 官方用户指南说明 Linux 提供预编译可执行文件，下载后放进 PATH 即可
RUN wget -O /tmp/ispc-v1.23.0-linux.tar.gz \
    https://github.com/ispc/ispc/releases/download/v1.23.0/ispc-v1.23.0-linux.tar.gz \
 && tar -xzf /tmp/ispc-v1.23.0-linux.tar.gz -C /tmp \
 && cp /tmp/ispc-v1.23.0-linux/bin/ispc /usr/local/bin/ispc \
 && chmod +x /usr/local/bin/ispc \
 && rm -rf /tmp/ispc-v1.23.0-linux /tmp/ispc-v1.23.0-linux.tar.gz

# 基础环境
ENV CUDA_HOME=/usr/local/cuda
ENV PATH="/usr/local/cuda/bin:/root/.local/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

ENV MAX_JOBS=8

# 基础 Python 打包工具
RUN python3 -m pip install --upgrade pip setuptools wheel

# 预装稳定基础依赖：PyTorch cu124 + 常见构建工具
RUN python3 -m pip install \
    torch==2.4.0 \
    torchvision \
    torchaudio \
    --index-url https://download.pytorch.org/whl/cu124

RUN python3 -m pip install \
    packaging \
    ninja \
    cmake \
    uv

CMD ["/bin/bash"]
